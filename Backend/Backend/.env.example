# Raspberry Pi direct HTTP bridge config
BACKEND_URL=http://192.168.1.30:8000/live-predict
DEVICE_ID=rpi-gateway-01
SEND_INTERVAL_SECONDS=5

# Feature values can be set individually from the real device or gateway.
# The names below must match the model feature names exactly.
HEADER_LENGTH=120
SYN_FLAG_NUMBER=1
RST_FLAG_NUMBER=0
HTTP=0
ARP=1
ICMP=0
LLC=2
TOT_SUM=48
MIN=2
IAT=9
NUMBER=13
MAGNITUE=0.8
COVARIANCE=0.33
WEIGHT=0.45
